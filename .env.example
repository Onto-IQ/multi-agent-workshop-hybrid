# คัดลอกเป็น .env ได้ถ้าต้องการ แต่ค่าเริ่มต้นของคลาสตั้งที่ตัวแปรของเครื่อง
# ไฟล์ .env ถูก git ignore — ห้าม commit ค่าจริง
#
# OpenCode อ่านคีย์จากตัวแปรนี้ผ่าน opencode.json ({env:OPENROUTER_API_KEY})
# วางคีย์ที่ศูนย์ฝึกให้ในตัวแปรของเครื่อง ห้ามใส่ค่าจริงในไฟล์นี้
OPENROUTER_API_KEY=

# คีย์เกตเวย์ https://model.ontoiq.tech ของศูนย์ฝึก
# provider "ontoiq" ใน opencode.json อ่านจากตัวแปรนี้อัตโนมัติผ่านฟิลด์ env
# วางคีย์ที่ศูนย์ฝึกให้ในตัวแปรของเครื่อง ห้ามใส่ค่าจริงในไฟล์นี้
ONTOIQ_API_KEY=

# ต้องว่างเสมอ ผู้เรียนใช้บัญชี Claude ของศูนย์ฝึก คีย์นี้จะทับการล็อกอิน
ANTHROPIC_API_KEY=

# ชื่อโมเดลเริ่มต้นของ OpenCode เช่น openrouter/anthropic/claude-sonnet-4.5
# ถ้าใช้เกตเวย์ของศูนย์ ตั้งเป็น ontoiq/<model-id ที่ได้จาก GET /v1/models>
OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-4.5
